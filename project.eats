# @name: SNES Sfxr
# @category: instrument
# @description: 16-Bit retro arcade and console sound effect synthesizer with procedural presets, random seeds, and SNES echo DSP.

# --- Parameter Definitions ---
def init():
    return {
        "SFXType": eat.param("SFXType", 0.0, 10.0, 0.0, options=["Laser", "Explosion", "Powerup", "Coin", "Jump", "Hurt", "Lose", "Button", "Warp", "Mutate", "Custom SNES"]),
        "Seed": eat.param("Seed", 1.0, 9999.0, 42.0, step=1.0),
        "Waveform": eat.param("Waveform", 0.0, 11.0, 1.0, options=["Sine", "Square", "Pulse 25%", "Pulse 12%", "Sawtooth", "Triangle", "Organ", "Strings", "Flute", "Slap Bass", "Chime", "Noise"]),
        "Attack": eat.param("Attack", 0.001, 0.5, 0.005, step=0.0),
        "Decay": eat.param("Decay", 0.01, 2.0, 0.35, step=0.0),
        "Sustain": eat.param("Sustain", 0.0, 1.0, 0.2, step=0.0),
        "Release": eat.param("Release", 0.01, 2.0, 0.2, step=0.0),
        "PitchSweep": eat.param("PitchSweep", -2.0, 2.0, -0.45, step=0.0),
        "VibratoRate": eat.param("VibratoRate", 0.0, 20.0, 0.0, step=0.0),
        "VibratoDepth": eat.param("VibratoDepth", 0.0, 1.0, 0.0, step=0.0),
        "EchoDelay": eat.param("EchoDelay", 16.0, 480.0, 120.0, step=16.0),
        "EchoFeedback": eat.param("EchoFeedback", 0.0, 0.95, 0.45, step=0.0),
        "EchoVolume": eat.param("EchoVolume", 0.0, 1.0, 0.35, step=0.0),
        "NoiseMix": eat.param("NoiseMix", 0.0, 1.0, 0.0, step=0.0),
    }

# --- Hardware GUI Layout ---
def gui():
    return {
        "panel": {
            "title": "SNES Sfxr",
            "subtitle": "16-Bit Procedural Sound Engine",
            "background": "snes",
            "accent": "#E52521",
            "knobStyle": "snes",
            "layout": [
                {
                    "type": "row",
                    "orientation": "vertical",
                    "align": "space_around",
                    "crossAlign": "center",
                    "children": [
                        {"type": "listbox", "param": "SFXType", "label": "SFX Type", "width": 160, "height": 90},
                        {"type": "listbox", "param": "Waveform", "label": "Wavetable", "width": 160, "height": 90},
                        {
                            "type": "column",
                            "orientation": "vertical",
                            "align": "space_around",
                            "crossAlign": "center",
                            "children": [
                                {"type": "nixie", "param": "Seed", "label": "RNG SEED", "width": 100},
                                {"type": "button", "action": "randomize", "label": "RANDOMIZE", "width": 100, "height": 32},
                            ],
                        },
                    ],
                },
                {
                    "type": "row",
                    "orientation": "vertical",
                    "align": "space_around",
                    "crossAlign": "center",
                    "children": [
                        {"type": "knob", "param": "Attack", "label": "ATTACK", "size": 36, "knobStyle": "hardware", "style": "two_tone_stepped", "hardware": "two_tone_stepped", "showValue": False, "capColor": "#CCC3CF", "bodyColor": "#DCDFE5", "indicatorColor": "#90939A", "dialColor": "#777777", "capSize": 0.98, "bodySize": 1.0, "indicatorLength": 0.95, "indicatorWidth": 1.0, "scale": "clean_ticks"},
                        {"type": "knob", "param": "Decay", "label": "DECAY", "size": 36, "knobStyle": "hardware", "style": "two_tone_stepped", "hardware": "two_tone_stepped", "showValue": False, "capColor": "#CCC3CF", "bodyColor": "#DCDFE5", "indicatorColor": "#90939A", "dialColor": "#777777", "capSize": 0.98, "bodySize": 1.0, "indicatorLength": 0.95, "indicatorWidth": 1.0, "scale": "clean_ticks"},
                        {"type": "knob", "param": "Sustain", "label": "SUSTAIN", "size": 36, "knobStyle": "hardware", "style": "two_tone_stepped", "hardware": "two_tone_stepped", "showValue": False, "capColor": "#CCC3CF", "bodyColor": "#DCDFE5", "indicatorColor": "#90939A", "dialColor": "#777777", "capSize": 0.98, "bodySize": 1.0, "indicatorLength": 0.95, "indicatorWidth": 1.0, "scale": "clean_ticks"},
