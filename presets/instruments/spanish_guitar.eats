# @id: spanish_guitar
# @name: Spanish Classical Guitar
# @category: instrument
# @description: Physical modeling of a Spanish concert classical guitar: nylon trebles & silver-wound bass waveguides, fingertip flesh vs fingernail ramp attack, Spanish Torres fan-braced acoustic body resonator (98Hz Helmholtz air cavity & 196Hz soundboard plate), and cedar/spruce tone balance.

# --- Parameter Definitions ---
def init():
    return {
        "FleshNail": eat.param("FleshNail", 0.0, 1.0, 0.4, step=0.0),
        "Scrape": eat.param("Scrape", 0.0, 1.0, 0.35, step=0.0),
        "StrumSpread": eat.param("StrumSpread", 1.0, 25.0, 4.0, step=0.0),
        "Sustain": eat.param("Sustain", 0.85, 0.9995, 0.9955, step=0.0),
        "BodyDamp": eat.param("BodyDamp", 0.05, 0.8, 0.24, step=0.0),
        "AirResonance": eat.param("AirResonance", -6.0, 8.0, 2.0, step=0.0),
        "WoodTone": eat.param("WoodTone", -6.0, 8.0, 1.5, step=0.0),
    }

