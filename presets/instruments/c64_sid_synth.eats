# @id: c64_sid_synth
# @name: Commodore 64 SID Synth
# @category: instrument
# @description: Authentic MOS 6581 / 8580 Commodore 64 Sound Interface Device: 12-bit Pulse Width Modulation (PWM), 23-bit Galois LFSR noise, hardware ADSR, 50Hz/60Hz chiptune arpeggiator, glissando, and 12dB/oct multimode resonant filter with non-linear FET saturation.

# --- Parameter Definitions ---
def init():
    return {
        "Waveform": eat.param("Waveform", 0.0, 5.0, 0.0, step=0.0, allow_variance=False),
        "PulseWidth": eat.param("PulseWidth", 100.0, 4000.0, 2048.0, step=0.0),
        "PwmRate": eat.param("PwmRate", 0.1, 10.0, 1.6, step=0.0),
        "PwmDepth": eat.param("PwmDepth", 0.0, 1.0, 0.45, step=0.0),
        "ArpMode": eat.param("ArpMode", 0.0, 5.0, 0.0, step=0.0, allow_variance=False),
        "GlideSpeed": eat.param("GlideSpeed", 0.0, 0.5, 0.0, step=0.0),
        "ChipModel": eat.param("ChipModel", 0.0, 1.0, 0.0, step=0.0, allow_variance=False),
        "FilterMode": eat.param("FilterMode", 0.0, 4.0, 0.0, step=0.0, allow_variance=False),
        "Cutoff": eat.param("Cutoff", 100.0, 2047.0, 1350.0, step=0.0),
        "Resonance": eat.param("Resonance", 0.0, 15.0, 9.0, step=0.0),
        "Overdrive": eat.param("Overdrive", 1.0, 3.0, 1.2, step=0.0),
        "Attack": eat.param("Attack", 0.0, 15.0, 1.0, step=0.0),
        "Decay": eat.param("Decay", 0.0, 15.0, 6.0, step=0.0),
        "Sustain": eat.param("Sustain", 0.0, 15.0, 12.0, step=0.0),
        "Release": eat.param("Release", 0.0, 15.0, 5.0, step=0.0),
    }

