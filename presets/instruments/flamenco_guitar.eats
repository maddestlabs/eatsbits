# @id: flamenco_guitar
# @name: Flamenco Guitar (Blanca)
# @category: instrument
# @description: Physical modeling of a Spanish Flamenco Blanca guitar: razor-sharp nail transient bite, rapid multi-finger rasgueados, low string action buzz/snap, Spanish cypress shallow body resonator, and integrated soundboard Golpe wood-tap percussion.

# --- Parameter Definitions ---
def init():
    return {
        "NailBite": eat.param("NailBite", 0.0, 1.0, 0.1, step=0.0),
        "GolpeTap": eat.param("GolpeTap", 0.0, 1.5, 0.4, step=0.0),
        "RasgueadoSpeed": eat.param("RasgueadoSpeed", 2.0, 35.0, 14.0, step=0.0),
        "Scrape": eat.param("Scrape", 0.0, 1.0, 0.5, step=0.0),
        "Sustain": eat.param("Sustain", 0.8, 0.998, 0.991, step=0.0),
        "SnapDamp": eat.param("SnapDamp", 0.05, 0.85, 0.28, step=0.0),
        "Bite": eat.param("Bite", -4.0, 10.0, 3.5, step=0.0),
    }

