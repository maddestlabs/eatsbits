# @id: solo_cello
# @name: Deep Solo Cello
# @category: instrument
# @description: Physical modeling of a rich concert violoncello: massive 98Hz Helmholtz air resonance, singing 180Hz top-plate wood formant, C-string sub-growl, expressive slow delayed vibrato, and full multi-articulation support (arco, pizz, spiccato, snap, sordino).

# --- Parameter Definitions ---
def init():
    return {
        "BowPressure": eat.param("BowPressure", 0.1, 2.5, 1.25, step=0.0),
        "BowSpeed": eat.param("BowSpeed", 0.1, 3.0, 0.9, step=0.0),
        "BowPos": eat.param("BowPos", 0.0, 1.0, 0.45, step=0.0),
        "RosinGrit": eat.param("RosinGrit", 0.0, 1.5, 0.48, step=0.0),
        "TremoloSpeed": eat.param("TremoloSpeed", 6.0, 18.0, 11.5, step=0.0),
        "Sustain": eat.param("Sustain", 0.9, 0.9998, 0.9972, step=0.0),
        "Damping": eat.param("Damping", 0.02, 0.8, 0.2, step=0.0),
        "VibratoDepth": eat.param("VibratoDepth", 0.0, 1.0, 0.32, step=0.0),
        "VibratoDelay": eat.param("VibratoDelay", 0.0, 0.6, 0.18, step=0.0),
        "WoodWarmth": eat.param("WoodWarmth", 0.0, 2.0, 0.68, step=0.0),
        "ChestResonance": eat.param("ChestResonance", -4.0, 10.0, 3.5, step=0.0),
        "ConSordino": eat.param("ConSordino", 0.0, 1.0, 0.0, step=0.0),
    }

# --- Hardware GUI Layout ---
