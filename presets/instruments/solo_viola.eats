                            "label": "VIOLA BODY",
                            "knobStyle": "vintage",
                            "size": 52,
                        },
                        {
                            "type": "knob",
                            "param": "ViolaWarmth",
                            "label": "1.8kHz WARMTH",
                            "unit": "dB",
                            "knobStyle": "vintage",
                            "size": 52,
                        },
                    ],
                },
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "hslider",
                            "param": "BowPos",
                            "label": "BOW POSITION (0.0 SUL TASTO <-> 0.5 NORMALE <-> 1.0 SUL PONTICELLO)",
                            "style": "capsule",
                        },
                    ],
                },
            ],
        },
    }

