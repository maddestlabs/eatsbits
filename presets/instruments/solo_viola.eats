# @id: solo_viola
# @name: Warm Solo Viola
# @category: instrument
# @description: Physical modeling of an expressive solo viola: deep C3-A6 gut/steel response, signature undersized acoustic cavity nasal resonance (220Hz/360Hz), warm melancholic body tone, stick-slip bow friction, and full articulation switching.

# --- Parameter Definitions ---
def init():
    return {
        "BowPressure": eat.param("BowPressure", 0.1, 2.5, 1.1, step=0.0),
        "BowSpeed": eat.param("BowSpeed", 0.1, 3.0, 0.95, step=0.0),
        "BowPos": eat.param("BowPos", 0.0, 1.0, 0.48, step=0.0),
        "RosinGrit": eat.param("RosinGrit", 0.0, 1.5, 0.4, step=0.0),
        "TremoloSpeed": eat.param("TremoloSpeed", 6.0, 20.0, 12.5, step=0.0),
        "Sustain": eat.param("Sustain", 0.9, 0.9995, 0.9962, step=0.0),
        "Damping": eat.param("Damping", 0.02, 0.8, 0.19, step=0.0),
        "VibratoDepth": eat.param("VibratoDepth", 0.0, 1.0, 0.28, step=0.0),
        "VibratoDelay": eat.param("VibratoDelay", 0.0, 0.6, 0.16, step=0.0),
        "WoodWarmth": eat.param("WoodWarmth", 0.0, 2.0, 0.6, step=0.0),
        "ViolaWarmth": eat.param("ViolaWarmth", -6.0, 8.0, 2.0, step=0.0),
        "ConSordino": eat.param("ConSordino", 0.0, 1.0, 0.0, step=0.0),
    }

# --- Hardware GUI Layout ---
