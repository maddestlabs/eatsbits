                        {"type": "knob", "param": "VibratoDepth", "label": "VIB DEPTH", "size": 44, "knobStyle": "hardware", "style": "two_tone_stepped", "hardware": "two_tone_stepped", "showValue": False, "capColor": "#CCC3CF", "bodyColor": "#DCDFE5", "indicatorColor": "#90939A", "dialColor": "#777777", "capSize": 0.98, "bodySize": 1.0, "indicatorLength": 0.95, "indicatorWidth": 1.0, "scale": "clean_ticks"},
                        {"type": "knob", "param": "EchoDelay", "label": "ECHO MS", "size": 44, "knobStyle": "hardware", "style": "two_tone_stepped", "hardware": "two_tone_stepped", "showValue": False, "capColor": "#CCC3CF", "bodyColor": "#DCDFE5", "indicatorColor": "#90939A", "dialColor": "#777777", "capSize": 0.98, "bodySize": 1.0, "indicatorLength": 0.95, "indicatorWidth": 1.0, "scale": "clean_ticks"},
