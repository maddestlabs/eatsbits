                    "children": [
                        {"type": "listbox", "param": "Waveform", "label": "Wavetable", "width": 180, "height": 90},
                        {"type": "knob", "param": "Attack", "label": "ATTACK", "size": 44, "knobStyle": "hardware", "style": "two_tone_stepped", "hardware": "two_tone_stepped", "showValue": False, "capColor": "#CCC3CF", "bodyColor": "#DCDFE5", "indicatorColor": "#90939A", "dialColor": "#777777", "capSize": 0.98, "bodySize": 1.0, "indicatorLength": 0.95, "indicatorWidth": 1.0, "scale": "clean_ticks"},
                        {"type": "knob", "param": "Decay", "label": "DECAY", "size": 44, "knobStyle": "hardware", "style": "two_tone_stepped", "hardware": "two_tone_stepped", "showValue": False, "capColor": "#CCC3CF", "bodyColor": "#DCDFE5", "indicatorColor": "#90939A", "dialColor": "#777777", "capSize": 0.98, "bodySize": 1.0, "indicatorLength": 0.95, "indicatorWidth": 1.0, "scale": "clean_ticks"},
                        {"type": "knob", "param": "Sustain", "label": "SUSTAIN", "size": 44, "knobStyle": "hardware", "style": "two_tone_stepped", "hardware": "two_tone_stepped", "showValue": False, "capColor": "#CCC3CF", "bodyColor": "#DCDFE5", "indicatorColor": "#90939A", "dialColor": "#777777", "capSize": 0.98, "bodySize": 1.0, "indicatorLength": 0.95, "indicatorWidth": 1.0, "scale": "clean_ticks"},
                        {"type": "knob", "param": "Release", "label": "RELEASE", "size": 44, "knobStyle": "hardware", "style": "two_tone_stepped", "hardware": "two_tone_stepped", "showValue": False, "capColor": "#CCC3CF", "bodyColor": "#DCDFE5", "indicatorColor": "#90939A", "dialColor": "#777777", "capSize": 0.98, "bodySize": 1.0, "indicatorLength": 0.95, "indicatorWidth": 1.0, "scale": "clean_ticks"},
