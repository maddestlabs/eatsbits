        "panel": {
            "title": "SNES Synth",
            "subtitle": "16-Bit Polyphonic S-DSP Console Synthesizer",
            "background": "snes",
            "accent": "#E52521",
            "knobStyle": "snes",
            "layout": [
                {
                    "type": "row",
                    "orientation": "vertical",
                    "align": "space_around",
