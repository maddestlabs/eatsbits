# @id: snes_drum_kit
# @name: SNES Drum Kit
# @category: instrument
# @description: 16-Bit S-DSP Console Drum Machine synthesizing authentic kicks, snares, toms, hats, cymbals, and percussion mapped to General MIDI drum notes (35-81).

# --- Parameter Definitions ---
def init():
    return {
        "MasterTune": eat.param("MasterTune", -12.0, 12.0, 0.0, step=1.0),
        "KickPunch": eat.param("KickPunch", 40.0, 220.0, 130.0, step=0.0),
        "SnareNoise": eat.param("SnareNoise", 0.0, 1.0, 0.65, step=0.0),
        "TomDecay": eat.param("TomDecay", 0.05, 1.0, 0.35, step=0.0),
        "CymbalDecay": eat.param("CymbalDecay", 0.1, 2.5, 0.80, step=0.0),
        "GaussianWarmth": eat.param("GaussianWarmth", 0.0, 1.0, 0.70, step=0.0),
        "EchoDelay": eat.param("EchoDelay", 16.0, 480.0, 128.0, step=16.0, allow_variance=False),
        "EchoFeedback": eat.param("EchoFeedback", 0.0, 0.95, 0.35, step=0.0),
        "EchoVolume": eat.param("EchoVolume", 0.0, 1.0, 0.25, step=0.0),
    }

