# @id: honky_tonk_piano
# @name: Honky-Tonk / Tack Piano
# @category: instrument
# @description: Physical modeling of a vintage Honky-Tonk / Tack Saloon Piano: metallic thumb-tack hammer strike, pronounced trichord unison chorus detuning (5–10 cents), wooden action clack, and bright midrange bite suited for roots, bluegrass, and ragtime.

# --- Parameter Definitions ---
def init():
    return {
        "TackBite": eat.param("TackBite", 0.0, 1.5, 0.85, step=0.0),
        "ActionClack": eat.param("ActionClack", 0.0, 1.0, 0.5, step=0.0),
        "DetuneCents": eat.param("DetuneCents", 2.0, 15.0, 7.5, step=0.0),
        "SaloonReso": eat.param("SaloonReso", 0.0, 1.0, 0.35, step=0.0),
        "MetalSheen": eat.param("MetalSheen", 0.0, 1.0, 0.6, step=0.0),
        "Bite": eat.param("Bite", -3.0, 9.0, 3.5, step=0.0),
        "Sustain": eat.param("Sustain", 0.9, 0.998, 0.996, step=0.0),
        "Tone": eat.param("Tone", 1000.0, 16000.0, 9500.0, step=0.0),
    }

