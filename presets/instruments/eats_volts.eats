# @id: eats_volts
# @name: Eats Volts
# @category: instrument
# @description: Physical modeling of real-world electricity, singing plasma arcs, and high-voltage discharge: asymmetric thermal expansion pulse oscillator, cycle-to-cycle spark jitter, Poisson-distributed corona sizzle, 60Hz substation transformer magnetostriction hum, dielectric breakdown attack snap, spark gap acoustic cavity formants, 4-stage plasma vortex phaser, and ozone saturation.

# --- Parameter Definitions ---
def init():
    return {
        "SynthTone": eat.param("SynthTone", 0.0, 1.0, 0.70, step=0.0),
        "Voltage": eat.param("Voltage", 0.1, 3.0, 1.25, step=0.0),
        "SparkGap": eat.param("SparkGap", 0.02, 0.5, 0.15, step=0.0),
        "Jitter": eat.param("Jitter", 0.0, 1.0, 0.45, step=0.0),
        "SubHarmonic": eat.param("SubHarmonic", 0.0, 1.0, 0.2, step=0.0),
        "CrackleRate": eat.param("CrackleRate", 0.0, 1.0, 0.4, step=0.0),
        "SnapAttack": eat.param("SnapAttack", 0.0, 2.5, 1.0, step=0.0),
        "GridHum": eat.param("GridHum", 0.0, 1.0, 0.35, step=0.0),
        "PhaserRate": eat.param("PhaserRate", 0.05, 8.0, 0.45, step=0.0),
        "PhaserDepth": eat.param("PhaserDepth", 0.0, 1.0, 0.65, step=0.0),
        "PhaserFeedback": eat.param("PhaserFeedback", 0.0, 1.0, 0.4, step=0.0),
        "PhaserMix": eat.param("PhaserMix", 0.0, 1.0, 0.45, step=0.0),
        "OzoneDrive": eat.param("OzoneDrive", 0.5, 5.0, 1.35, step=0.0),
        "ToneHighpass": eat.param("ToneHighpass", 20.0, 2000.0, 30.0, step=0.0),
        "Tone": eat.param("Tone", 1000.0, 16000.0, 8500.0, step=0.0),
        "Decay": eat.param("Decay", 0.05, 2.0, 0.45, step=0.0),
    }

