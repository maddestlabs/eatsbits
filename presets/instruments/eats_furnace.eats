# @id: eats_furnace
# @name: Eats Furnace
# @category: instrument
# @description: Physical modeling of real-world thermoacoustic combustion and blast furnaces: Kastner Rijke singing flame oscillator, convective temperature drift, turbulent combustion roar, supercritical wood sap pocket explosions, flying ember sizzles, deflagration flashover whoosh, thermal convection phaser, and tuned glass/brass draft cylinder resonance.

# --- Parameter Definitions ---
def init():
    return {
        "SynthTone": eat.param("SynthTone", 0.0, 1.0, 0.70, step=0.0),
        "FuelPressure": eat.param("FuelPressure", 0.1, 3.0, 1.25, step=0.0),
        "FlameCusp": eat.param("FlameCusp", 0.0, 1.0, 0.45, step=0.0),
        "TubeResonance": eat.param("TubeResonance", 0.0, 1.0, 0.5, step=0.0),
        "IgnitionSnap": eat.param("IgnitionSnap", 0.0, 2.5, 0.85, step=0.0),
        "CombustionRoar": eat.param("CombustionRoar", 0.0, 1.0, 0.35, step=0.0),
        "OxygenDraft": eat.param("OxygenDraft", 0.0, 1.0, 0.4, step=0.0),
        "SapCrackle": eat.param("SapCrackle", 0.0, 1.0, 0.4, step=0.0),
        "EmberSizzle": eat.param("EmberSizzle", 0.0, 1.0, 0.35, step=0.0),
        "PhaserRate": eat.param("PhaserRate", 0.05, 8.0, 0.35, step=0.0),
        "PhaserDepth": eat.param("PhaserDepth", 0.0, 1.0, 0.55, step=0.0),
        "PhaserFeedback": eat.param("PhaserFeedback", 0.0, 1.0, 0.35, step=0.0),
        "PhaserMix": eat.param("PhaserMix", 0.0, 1.0, 0.4, step=0.0),
        "ToneHighpass": eat.param("ToneHighpass", 20.0, 2000.0, 25.0, step=0.0),
        "Tone": eat.param("Tone", 800.0, 16000.0, 7500.0, step=0.0),
        "Decay": eat.param("Decay", 0.05, 2.5, 0.5, step=0.0),
    }

