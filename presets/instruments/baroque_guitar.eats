# @id: baroque_guitar
# @name: Baroque Guitar (5-Course)
# @category: instrument
# @description: Physical modeling of a 5-course re-entrant Baroque guitar: coupled double-course gut strings with high octave chime, rapid multi-finger rasgueado fan rakes, shallow body resonator with ornate parchment rose rosette damping, and bright gut bite.

# --- Parameter Definitions ---
def init():
    return {
        "RasgueadoSpeed": eat.param("RasgueadoSpeed", 2.0, 35.0, 12.0, step=0.0),
        "NailPluck": eat.param("NailPluck", 0.0, 1.0, 0.3, step=0.0),
        "GutScrape": eat.param("GutScrape", 0.0, 1.0, 0.45, step=0.0),
        "CourseDetune": eat.param("CourseDetune", 0.0, 12.0, 4.5, step=0.0),
        "OctaveCourses": eat.param("OctaveCourses", 0.0, 1.0, 1.0, step=0.0, allow_variance=False),
        "Sustain": eat.param("Sustain", 0.85, 0.999, 0.9935, step=0.0),
        "StringDamp": eat.param("StringDamp", 0.05, 0.7, 0.18, step=0.0),
        "RoseBite": eat.param("RoseBite", -6.0, 10.0, 3.0, step=0.0),
    }

