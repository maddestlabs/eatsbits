# @id: reggae_guitar
# @name: Dub Guitar
# @category: instrument
# @description: Physical modeling of a clean single-coil/P90 electric guitar for reggae and dub music: multi-string plectrum strum rake, Karplus-Strong waveguide with palm mute damping, 130Hz sub-bass cut, 3.2kHz pick bite, and vintage tube preamp. Best paired with Cab Designer FX (2x12 Open-Back cab)!

# --- Parameter Definitions ---
def init():
    return {
        "StrumSpread": eat.param("StrumSpread", 2.0, 30.0, 8.5, step=0.0),
        "PickBite": eat.param("PickBite", 0.2, 3.0, 1.25, step=0.0),
        "PalmDamp": eat.param("PalmDamp", 0.05, 0.9, 0.42, step=0.0),
        "ChopDecay": eat.param("ChopDecay", 0.04, 0.6, 0.18, step=0.0),
        "Sustain": eat.param("Sustain", 0.85, 0.999, 0.994, step=0.0),
        "BiteGain": eat.param("BiteGain", -6.0, 12.0, 4.5, step=0.0),
        "ToneCutoff": eat.param("ToneCutoff", 2000.0, 12000.0, 6800.0, step=0.0),
        "Drive": eat.param("Drive", 0.5, 3.0, 1.15, step=0.0),
    }

