# @id: fretless_bass
# @name: Fretless J-Bass
# @category: instrument
# @description: Physical model of a vintage fretless electric Jazz Bass: non-linear fingerboard boundary damping with blooming "Mwah" harmonic buzz, dual single-coil magnetic pickups with 1.6kHz bridge bark, and active 2-band tone stack.

# --- Parameter Definitions ---
def init():
    return {
        "MwahAmount": eat.param("MwahAmount", 0.0, 1.0, 0.75, step=0.0),
        "Growl": eat.param("Growl", 0.0, 1.0, 0.6, step=0.0),
        "FingerDamping": eat.param("FingerDamping", 0.05, 0.6, 0.22, step=0.0),
        "BridgePickup": eat.param("BridgePickup", 0.0, 1.0, 0.9, step=0.0),
        "MidBark": eat.param("MidBark", -6.0, 12.0, 3.5, step=0.0),
        "Sustain": eat.param("Sustain", 0.85, 0.999, 0.996, step=0.0),
        "Drive": eat.param("Drive", 0.5, 3.0, 1.1, step=0.0),
    }

