# @id: vibraphone
# @name: Vibraphone
# @category: instrument
# @description: Physical modal modeling of an orchestral vibraphone: undercut arched aluminum alloy bar with Mode 2 tuned to the double octave (4.0 * f0), singing sustain, wound yarn mallet attack, and motor-driven rotating butterfly valve resonator tube tremolo/phase modulation.

# --- Parameter Definitions ---
def init():
    return {
        "BarDecay": eat.param("BarDecay", 1.0, 8.0, 4.5, step=0.0),
        "MotorSpeed": eat.param("MotorSpeed", 0.5, 9.0, 4.2, step=0.0),
        "TremoloDepth": eat.param("TremoloDepth", 0.0, 1.0, 0.6, step=0.0),
        "DoubleOctave": eat.param("DoubleOctave", 0.0, 1.0, 0.4, step=0.0, allow_variance=False),
        "YarnSoftness": eat.param("YarnSoftness", 0.0, 1.0, 0.5, step=0.0),
        "ToneCut": eat.param("ToneCut", 2000.0, 16000.0, 9500.0, step=0.0),
    }

