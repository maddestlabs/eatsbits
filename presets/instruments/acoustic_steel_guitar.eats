# @id: acoustic_steel_guitar
# @name: Steel-String Acoustic Guitar
# @category: instrument
# @description: Physical modeling of a steel-string acoustic guitar: phosphor bronze string waveguide, flatpick vs fingerpick attack, and morphable body geometry (0.0 Parlor/000 <-> 0.5 Dreadnought <-> 1.0 Jumbo).

# --- Parameter Definitions ---
def init():
    return {
        "PickStyle": eat.param("PickStyle", 0.0, 1.0, 0.3, step=0.0),
        "WoundScrape": eat.param("WoundScrape", 0.0, 1.0, 0.4, step=0.0),
        "StrumSpread": eat.param("StrumSpread", 1.0, 25.0, 5.0, step=0.0),
        "Sustain": eat.param("Sustain", 0.85, 0.9995, 0.996, step=0.0),
        "Damping": eat.param("Damping", 0.05, 0.75, 0.22, step=0.0),
        "BodyProfile": eat.param("BodyProfile", 0.0, 1.0, 0.5, step=0.0),
        "BodyWood": eat.param("BodyWood", 0.0, 1.5, 0.5, step=0.0),
        "BronzeSparkle": eat.param("BronzeSparkle", -6.0, 8.0, 2.0, step=0.0),
    }

