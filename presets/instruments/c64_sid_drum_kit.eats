                                {
                                    "type": "knob",
                                    "param": "NoiseMetal",
                                    "label": "NOISE METAL",
                                    "knobStyle": "chrome",
                                    "size": 52,
                                },
                                {
                                    "type": "knob",
                                    "param": "ChipModel",
