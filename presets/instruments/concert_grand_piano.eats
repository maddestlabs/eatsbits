# --- Modular DSP Synthesis Graph ---
def graph():
    strike = eat.node.hammer(hardness="HammerHardness", click=1.0)
    strings = eat.node.waveguide(in_sig=strike, damping="Brightness", feedback=0.996)
    body = eat.node.acoustic_body(in_sig=strings, profile=0.8, gain="LidOpen")
    return body

# --- Synthesizer Voice DSP Process Hook ---
def process(time, freq, note, params):
    return 0.0
