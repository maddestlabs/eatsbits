# @id: hawaiian_ukulele
# @name: Hawaiian Ukulele
# @category: instrument
# @description: Physical modeling of a traditional Hawaiian acoustic concert ukulele: nylon/fluorocarbon 4-string strum brush, Karplus-Strong waveguide with acoustic loss damping, Hawaiian Koa wood soundboard and air cavity modal resonance (330Hz, 590Hz, 1150Hz), 180Hz sub cut, and 2.8kHz island brightness.

# --- Parameter Definitions ---
def init():
    return {
        "StrumSpread": eat.param("StrumSpread", 2.0, 25.0, 6.5, step=0.0),
        "PluckSnap": eat.param("PluckSnap", 0.2, 3.0, 1.1, step=0.0),
        "Damping": eat.param("Damping", 0.05, 0.85, 0.32, step=0.0),
        "Decay": eat.param("Decay", 0.08, 1.2, 0.35, step=0.0),
        "Sustain": eat.param("Sustain", 0.85, 0.999, 0.99, step=0.0),
        "Brightness": eat.param("Brightness", -6.0, 10.0, 3.5, step=0.0),
        "Tone": eat.param("Tone", 2500.0, 14000.0, 7200.0, step=0.0),
    }

