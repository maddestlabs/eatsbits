# @id: agogo_bell
# @name: Agogô Bell
# @category: instrument
# @description: Physical modal modeling of an Agogô / Cowbell (GM 113 / 114): welded sheet metal double bell with coupled plate modes (1.0, 1.54), hardwood stick strike crack, and dynamic pitch deflection on hard hits.

# --- Parameter Definitions ---
def init():
    return {
        "BellDecay": eat.param("BellDecay", 0.2, 2.2, 0.75, step=0.0),
        "ClangRatio": eat.param("ClangRatio", 0.0, 1.5, 0.65, step=0.0),
        "StickHardness": eat.param("StickHardness", 0.2, 1.2, 0.7, step=0.0),
        "PitchBend": eat.param("PitchBend", 0.0, 1.0, 0.4, step=0.0),
        "MetalSnap": eat.param("MetalSnap", -3.0, 6.0, 2.0, step=0.0),
        "Tone": eat.param("Tone", 2000.0, 18000.0, 13000.0, step=0.0),
    }

