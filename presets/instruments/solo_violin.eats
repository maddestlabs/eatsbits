# @id: solo_violin
# @name: Virtuoso Solo Violin
# @category: instrument
# @description: Physical modeling of an expressive concert solo violin: MSW stick-slip bow friction, organic gut/steel string damping, Stradivarius spruce body modal resonance (280Hz/480Hz/580Hz), and 3-stage luthier EQ (480Hz wood core + 2.8kHz bridge presence + 6.0kHz soprano air sheen).

# --- Parameter Definitions ---
def init():
    return {
        "BowPressure": eat.param("BowPressure", 0.1, 2.5, 1.05, step=0.0),
        "BowSpeed": eat.param("BowSpeed", 0.1, 3.0, 0.98, step=0.0),
        "BowPos": eat.param("BowPos", 0.0, 1.0, 0.5, step=0.0),
        "RosinGrit": eat.param("RosinGrit", 0.0, 1.5, 0.32, step=0.0),
        "TremoloSpeed": eat.param("TremoloSpeed", 6.0, 20.0, 13.0, step=0.0),
        "Sustain": eat.param("Sustain", 0.9, 0.9995, 0.9962, step=0.0),
        "Damping": eat.param("Damping", 0.02, 0.8, 0.2, step=0.0),
        "VibratoDepth": eat.param("VibratoDepth", 0.0, 1.0, 0.3, step=0.0),
        "VibratoDelay": eat.param("VibratoDelay", 0.0, 0.6, 0.15, step=0.0),
        "WoodWarmth": eat.param("WoodWarmth", 0.0, 2.0, 0.68, step=0.0),
        "ViolinCore": eat.param("ViolinCore", -6.0, 8.0, 2.5, step=0.0),
        "BridgeHill": eat.param("BridgeHill", -6.0, 8.0, 3.0, step=0.0),
        "AirSheen": eat.param("AirSheen", -6.0, 8.0, 1.8, step=0.0),
        "ConSordino": eat.param("ConSordino", 0.0, 1.0, 0.0, step=0.0),
    }

