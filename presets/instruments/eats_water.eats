# @id: eats_water
# @name: Eats Water
# @category: instrument
# @description: Physical modeling of real-world water, pressurized waterjets, and bubble cavitation: Steve Mann hydraulophone jet oscillator, Minnaert bubble pinch-off frequency chirp, hydrodynamic whirlpool vortex churning, droplet splash & foam spray matrix, 4-stage fluid Doppler phaser, and submerged hydrophone acoustics.

# --- Parameter Definitions ---
def init():
    return {
        "SynthTone": eat.param("SynthTone", 0.0, 1.0, 0.70, step=0.0),
        "WaterFlow": eat.param("WaterFlow", 0.1, 3.0, 1.25, step=0.0),
        "BubblePinch": eat.param("BubblePinch", 0.0, 1.0, 0.45, step=0.0),
        "Viscosity": eat.param("Viscosity", 0.0, 1.0, 0.4, step=0.0),
        "PlungeImpact": eat.param("PlungeImpact", 0.0, 2.5, 0.85, step=0.0),
        "Turbulence": eat.param("Turbulence", 0.0, 1.0, 0.35, step=0.0),
        "CurrentDrift": eat.param("CurrentDrift", 0.0, 1.0, 0.35, step=0.0),
        "DropletRate": eat.param("DropletRate", 0.0, 1.0, 0.4, step=0.0),
        "SprayHiss": eat.param("SprayHiss", 0.0, 1.0, 0.35, step=0.0),
        "PhaserRate": eat.param("PhaserRate", 0.05, 8.0, 0.28, step=0.0),
        "PhaserDepth": eat.param("PhaserDepth", 0.0, 1.0, 0.6, step=0.0),
        "PhaserFeedback": eat.param("PhaserFeedback", 0.0, 1.0, 0.45, step=0.0),
        "PhaserMix": eat.param("PhaserMix", 0.0, 1.0, 0.45, step=0.0),
        "ToneHighpass": eat.param("ToneHighpass", 20.0, 2000.0, 20.0, step=0.0),
        "Depth": eat.param("Depth", 500.0, 16000.0, 6500.0, step=0.0),
        "Decay": eat.param("Decay", 0.05, 2.5, 0.5, step=0.0),
    }

