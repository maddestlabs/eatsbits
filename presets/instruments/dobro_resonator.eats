# @id: dobro_resonator
# @name: Resonator Guitar (Dobro)
# @category: instrument
# @description: Physical modeling of a spun aluminum cone resonator/dobro guitar: spider & biscuit bridge modal formants (720Hz, 1450Hz, 2150Hz), steel slide glissando friction, and blues bark.

# --- Parameter Definitions ---
def init():
    return {
        "ConeType": eat.param("ConeType", 0.0, 1.0, 0.35, step=0.0, allow_variance=False),
        "MetalBark": eat.param("MetalBark", 0.0, 2.0, 0.6, step=0.0),
        "ThumbPick": eat.param("ThumbPick", 0.0, 1.0, 0.1, step=0.0),
        "SlideFriction": eat.param("SlideFriction", 0.0, 1.0, 0.6, step=0.0),
        "Sustain": eat.param("Sustain", 0.85, 0.999, 0.994, step=0.0),
        "SlideTone": eat.param("SlideTone", -6.0, 8.0, 3.5, step=0.0),
    }

