# --- Modular DSP Synthesis Graph ---
def graph():
    strike = eat.node.hammer(hardness="FeltDamping", click=0.5)
    strings = eat.node.waveguide(in_sig=strike, damping="Warmth", feedback=0.993)
    body = eat.node.acoustic_body(in_sig=strings, profile=0.5, gain=0.6)
    return body

# --- Synthesizer Voice DSP Process Hook ---
def process(time, freq, note, params):
    return 0.0
