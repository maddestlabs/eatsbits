# @id: felt_upright_piano
# @name: Warm Felt Studio Upright
# @category: instrument
# @description: Physical modeling of a warm, felt-damped studio upright piano: thick wool felt compression layer, shortened upright string scale, intimate wooden action knock, compact soundboard resonance, and warm harmonic roll-off designed to sit beneath acoustic guitars.

# --- Parameter Definitions ---
def init():
    return {
        "FeltThickness": eat.param("FeltThickness", 0.0, 1.0, 0.85, step=0.0),
        "HammerHardness": eat.param("HammerHardness", 0.1, 1.5, 0.35, step=0.0),
        "MechanicalThud": eat.param("MechanicalThud", 0.0, 1.0, 0.45, step=0.0),
        "CabinetSize": eat.param("CabinetSize", 0.0, 1.0, 0.2, step=0.0),
        "BodyReso": eat.param("BodyReso", 0.0, 1.0, 0.4, step=0.0),
        "AirSheen": eat.param("AirSheen", 0.0, 1.0, 0.15, step=0.0),
        "UnisonDetune": eat.param("UnisonDetune", 0.5, 6.0, 2.4, step=0.0),
        "Sustain": eat.param("Sustain", 0.9, 0.998, 0.9945, step=0.0),
        "Tone": eat.param("Tone", 800.0, 8000.0, 3800.0, step=0.0),
    }

