                        },
                        {
                            "type": "knob",
                            "param": "Sustain",
                            "label": "SUSTAIN",
                            "knobStyle": "vintage",
                            "size": 52,
                        },
                        {
                            "type": "knob",
                            "param": "MandolinBite",
