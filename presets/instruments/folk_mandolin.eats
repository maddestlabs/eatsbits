# @id: folk_mandolin
# @name: Folk Mandolin (Double-Course)
# @category: instrument
# @description: Physical modeling of an 8-string folk mandolin: 4 paired double courses with 3.2-cent micro-chorus, carved arched spruce soundboard with f-holes, and rapid tremolo alternate picking.

# --- Parameter Definitions ---
def init():
    return {
        "CourseDetune": eat.param("CourseDetune", 0.0, 8.0, 3.2, step=0.0),
        "TremoloSpeed": eat.param("TremoloSpeed", 1.0, 15.0, 4.0, step=0.0),
        "PickBite": eat.param("PickBite", 0.0, 1.0, 0.05, step=0.0),
        "Sustain": eat.param("Sustain", 0.85, 0.999, 0.993, step=0.0),
        "Damping": eat.param("Damping", 0.05, 0.7, 0.22, step=0.0),
        "MandolinBite": eat.param("MandolinBite", -4.0, 8.0, 3.0, step=0.0),
    }

