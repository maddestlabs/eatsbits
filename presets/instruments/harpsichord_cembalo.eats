# @id: harpsichord_cembalo
# @name: Harpsichord / Cembalo
# @category: instrument
# @description: Authentic physical model of a Flemish/Italian Baroque Harpsichord (Cembalo): Delrin/crow quill plectrum pluck excitation, velocity-invariant acoustic touch, dual 8' Principal and 4' Octave register stops, buff/lute felt damping, spruce soundboard modal cavity resonator, and mechanical wooden jack release noise.

# --- Parameter Definitions ---
def init():
    return {
        "Stop4Octave": eat.param("Stop4Octave", 0.0, 1.0, 0.35, step=0.0, allow_variance=False),
        "BuffStop": eat.param("BuffStop", 0.05, 0.8, 0.18, step=0.0),
        "PluckBite": eat.param("PluckBite", 0.1, 3.0, 1.45, step=0.0),
        "ScrapeLevel": eat.param("ScrapeLevel", 0.0, 2.0, 0.4, step=0.0),
        "Sustain": eat.param("Sustain", 0.85, 0.999, 0.995, step=0.0),
        "AirSparkle": eat.param("AirSparkle", -6.0, 12.0, 2.0, step=0.0),
        "JackRelease": eat.param("JackRelease", 0.0, 1.0, 0.35, step=0.0),
    }

