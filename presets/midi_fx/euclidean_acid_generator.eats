# @id: euclidean_acid_gen
# @name: Euclidean Acid Generator
# @category: midiFx
# @tags: euclidean, acid, generative, bassline, sequencer, algorithmic
# @description: Generates algorithmic 16-step Euclidean bassline snapped to the song scale.

def init():
    return {
        "hits": eat.param("hits", 1.0, 16.0, 7.0, step=1.0),
        "steps": eat.param("steps", 4.0, 32.0, 16.0, step=1.0),
        "root_pitch": eat.param("root_pitch", 24.0, 60.0, 36.0, step=1.0),
    }

def transform_notes(notes, params, time_ctx):
    return eat.euclidean(
        notes,
        hits=params.get("hits", 7.0),
        steps=params.get("steps", 16.0),
        root_pitch=params.get("root_pitch", 36.0)
    )

def gui():
    return {
        "panel": {
            "title": "EUCLIDEAN ACID GEN",
            "subtitle": "Algorithmic Rhythm & Bassline Generator",
            "background": "dark",
            "accent": "#00FF7F",
            "layout": [
                {
                    "type": "row",
                    "children": [
                        {"type": "knob", "param": "hits", "label": "HITS", "size": 52},
                        {"type": "knob", "param": "steps", "label": "STEPS", "size": 52},
                        {"type": "knob", "param": "root_pitch", "label": "ROOT", "size": 52}
                    ]
                }
            ]
        }
    }
