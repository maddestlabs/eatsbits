        "panel": {
            "title": "DUAL-MIC FM ACOUSTIC KICK",
            "subtitle": "Physical Nearfield/Farfield Excitation Processor",
            "accent": "track",
            "layout": [
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "nixie",
                            "param": "NearPitchStart",
                            "label": "PUNCH FREQ",
                            "unit": "Hz",
                        },
                        {
                            "type": "nixie",
                            "param": "NearPitchEnd",
                            "label": "SUB FREQ",
                            "unit": "Hz",
                        },
                        {
                            "type": "nixie",
                            "param": "NearFmDepth",
