# @id: eats_909_drumpad
# @name: Eats-909 Drum Machine & Pad Workstation
# @category: instrument
# @tags: drum, 909, techno, house, vintage, drumpad, kit, mpc
# @description: Dedicated 16/32-pad rhythm composer workstation with authentic 909 physical kick, dual body snare, 6-bit hats, clap, rimshot, crash, and ride.

def init():
    return {
        "MasterTune": eat.param("MasterTune", -12.0, 12.0, 0.0, step=0.0),
        "KitDrive": eat.param("KitDrive", 0.0, 1.0, 0.25, step=0.0),
        "RoomLevel": eat.param("RoomLevel", 0.0, 1.0, 0.15, step=0.0),
        "Attack": eat.param("Attack", 0.0, 1.0, 0.60, step=0.0),
        "Decay": eat.param("Decay", 0.0, 1.0, 0.70, step=0.0),
        "Snappy": eat.param("Snappy", 0.0, 1.0, 0.75, step=0.0),
        "Humanize": eat.param("Humanize", 0.0, 1.0, 0.15, step=0.0),
        "Dynamics": eat.param("Dynamics", 0.0, 1.0, 0.90, step=0.0),
    }

def gui():
    return {
        "panel": {
            "title": "EATS-909 RHYTHM COMPOSER",
            "subtitle": "16-Pad Pure DSP 909 Studio & Performance Workstation",
            "background": "dark",
            "accent": "#1E88E5",
            "layout": [
                {
                    "type": "row",
                    "children": [
                        {"type": "knob", "param": "MasterTune", "label": "TUNE", "size": 52},
                        {"type": "knob", "param": "KitDrive", "label": "DRIVE", "size": 52},
                        {"type": "knob", "param": "RoomLevel", "label": "ROOM", "size": 52},
                        {"type": "knob", "param": "Attack", "label": "ATTACK", "size": 52},
                        {"type": "knob", "param": "Decay", "label": "DECAY", "size": 52},
                        {"type": "knob", "param": "Snappy", "label": "SNAPPY", "size": 52},
                        {"type": "knob", "param": "Humanize", "label": "HUMANIZE", "size": 52},
                        {"type": "knob", "param": "Dynamics", "label": "DYNAMICS", "size": 52}
                    ]
                }
            ]
        }
    }
