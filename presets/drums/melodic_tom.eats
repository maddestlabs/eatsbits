# --- Modular Synthesis Graph Topology ---
def graph():
    tom = eat.node.melodic_tom(decay="TomDecay", coupling="HeadCoupling", pitch_bend="PitchBend", stick="StickCrack")
    filtered = eat.node.svf(tom, cutoff="Tone", type="lowpass")
    out = eat.node.saturate(filtered, drive=1.1)
    return out

# --- Synthesizer Voice DSP Process Hook ---
def process(time, freq, note, params):
    return 0.0
