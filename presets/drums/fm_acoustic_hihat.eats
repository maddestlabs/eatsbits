# @id: fm_acoustic_hihat
# @name: FM Acoustic Hi-Hat
# @category: instrument
# @description: Physical acoustic hi-hat combining inharmonic metallic oscillator cluster, stick ping click, and high-pass sizzle EQ.

# --- Parameter Definitions ---
def init():
    return {
        "Cutoff": eat.param("Cutoff", 4000.0, 14000.0, 7000.0, step=0.0),
        "Decay": eat.param("Decay", 0.02, 0.6, 0.08, step=0.0),
        "Sizzle": eat.param("Sizzle", 0.0, 1.0, 0.65, step=0.0),
        "Tone": eat.param("Tone", 0.5, 2.0, 1.0, step=0.0),
        "Variance": eat.param("Variance", 0.0, 1.0, 0.15, step=0.0),
    }

# --- Hardware GUI Layout ---
def gui():
    return {
        "panel": {
            "title": "PHYSICAL METALLIC HI-HAT",
            "subtitle": "6-Osc Inharmonic Cluster with Stick Transient",
            "accent": "track",
            "layout": [
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "nixie",
                            "param": "Cutoff",
                            "label": "HPF CUTOFF",
                            "unit": "Hz",
                        },
                        {
                            "type": "nixie",
                            "param": "Decay",
                            "label": "DECAY TIME",
                            "unit": "s",
                        },
                    ],
                },
                {
                    "type": "row",
                    "children": [
                        {
                            "type": "knob",
                            "param": "Cutoff",
                            "label": "CUTOFF",
                            "size": 56,
                        },
                        {
                            "type": "knob",
                            "param": "Decay",
                            "label": "DECAY",
                            "size": 56,
                        },
                        {
                            "type": "knob",
                            "param": "Sizzle",
                            "label": "SIZZLE",
                            "size": 52,
                        },
                        {
                            "type": "knob",
                            "param": "Tone",
                            "label": "CLUSTER TONE",
                            "size": 52,
                        },
                        {
                            "type": "knob",
                            "param": "Variance",
                            "label": "VARIANCE",
                            "size": 52,
                        },
                    ],
                },
            ],
        },
    }
