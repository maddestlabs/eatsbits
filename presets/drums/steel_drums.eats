                                    "param": "PanDecay",
                                    "label": "SUSTAIN",
                                    "unit": "s",
                                    "size": 52,
                                },
                                {
                                    "type": "knob",
                                    "param": "OctaveHarmonic",
                                    "label": "OCTAVES",
