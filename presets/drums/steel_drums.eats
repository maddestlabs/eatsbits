                    ],
                },
                {
                    "type": "group",
                    "label": "RUBBER MALLET & AIR",
                    "accent": "#264653",
                    "children": [
                        {
                            "type": "row",
                            "children": [
                                {
                                    "type": "knob",
                                    "param": "MalletSoftness",
                                    "label": "RUBBER",
                                    "unit": "%",
