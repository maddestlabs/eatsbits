# @id: synth_drum
# @name: Simmons Synth Drum
# @category: instrument
# @description: Physical analog circuit simulation of the classic 1980s Simmons SDS-V Electronic Drum (GM 118 / 119): polycarbonate pad stick click generator, downward exponential pitch sweep VCO, resonant 4-pole lowpass VCF sweep, and filtered white noise snap.

# --- Parameter Definitions ---
def init():
    return {
        "PitchDrop": eat.param("PitchDrop", 0.1, 1.0, 0.7, step=0.0),
        "SweepTime": eat.param("SweepTime", 0.04, 0.35, 0.14, step=0.0),
        "ClickLevel": eat.param("ClickLevel", 0.0, 1.2, 0.65, step=0.0),
        "NoiseSnap": eat.param("NoiseSnap", 0.0, 1.0, 0.45, step=0.0),
        "ToneDecay": eat.param("ToneDecay", 0.2, 2.2, 0.8, step=0.0),
        "FilterReso": eat.param("FilterReso", 0.0, 0.9, 0.5, step=0.0),
    }

