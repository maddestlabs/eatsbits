# --- Modular Physical Modeling Graph Topology ---
def graph():
    bachi = eat.node.hammer(hardness="BachiImpact", click=0.9)
    membrane = eat.node.modal_bank(bachi, structure="drum")
    body = eat.node.acoustic_body(membrane, profile=0.8, gain="BarrelBoom")
    sub = eat.node.svf(body, cutoff=100.0, gain=3.0, type="lowshelf")
    return sub

# --- Synthesizer Voice DSP Process Hook ---
def process(time, freq, note, params):
    return 0.0
