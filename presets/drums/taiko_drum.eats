# @id: taiko_drum
# @name: Taiko Drum
# @category: instrument
# @description: Physical modal modeling of a Japanese Taiko Drum / Surdo (GM 116 / 117): heavy carved wooden barrel shell, 2D circular clamped Bessel membrane modes, thick bachi stick slap, dynamic pitch sag, and deep barrel cavity boom.

# --- Parameter Definitions ---
def init():
    return {
        "DrumDecay": eat.param("DrumDecay", 0.4, 3.5, 1.6, step=0.0),
        "PitchSag": eat.param("PitchSag", 0.0, 1.0, 0.5, step=0.0),
        "BachiImpact": eat.param("BachiImpact", 0.2, 1.2, 0.75, step=0.0),
        "BarrelBoom": eat.param("BarrelBoom", 0.0, 1.2, 0.65, step=0.0),
        "SubBoost": eat.param("SubBoost", -2.0, 8.0, 3.0, step=0.0),
        "Tone": eat.param("Tone", 1000.0, 16000.0, 8000.0, step=0.0),
    }

