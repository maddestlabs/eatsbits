# @id: eats_303
# @name: Eats-303
# @category: instrument
# @description: Authentic Eats-303 acid bassline emulation with 24dB 4-Pole Diode Ladder filter, 150Hz feedback highpass loop, leaky integrator saw/square oscillators, accent decay override, 60ms slide portamento, and overdrive. DSP synthesis inspired by midilab/jc303 (Jean-Christophe Taveau) and Robin Schmidt (Open303).

# --- Parameter Definitions ---
def init():
    return {
        "Waveform": eat.param("Waveform", 0.0, 1.0, 0.0, step=1.0, allow_variance=False),
        "Pitch": eat.param("Pitch", -12.0, 12.0, 0.0, step=1.0, allow_variance=False),
        "Cutoff": eat.param("Cutoff", 200.0, 4500.0, 1400.0, step=0.0),
        "Resonance": eat.param("Resonance", 0.5, 16.0, 9.2, step=0.0),
        "EnvMod": eat.param("EnvMod", 0.0, 1.0, 0.75, step=0.0),
        "Decay": eat.param("Decay", 0.05, 1.2, 0.28, step=0.0),
        "Accent": eat.param("Accent", 0.0, 1.0, 0.78, step=0.0),
        "Octave": eat.param("Octave", -2.0, 0.0, 0.0, step=1.0, allow_variance=False),
        "SubWaveform": eat.param("SubWaveform", 0.0, 1.0, 0.0, step=1.0, allow_variance=False),
        "SubVolume": eat.param("SubVolume", 0.0, 1.0, 0.0, step=0.0),
        "Drive": eat.param("Drive", 0.0, 1.0, 0.25, step=0.0),
        "Slide": eat.param("Slide", 0.0, 1.0, 0.0, step=0.0),
    }

